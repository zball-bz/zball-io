<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}zball</title>
{%- if robots %}
<meta name="robots" content="{{ robots }}">
{%- endif %}
<link rel="alternate" type="application/atom+xml" href="/feed.xml" title="zball">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;700&display=swap">
<style>
/* Latin face is SELF-HOSTED and declared to the engine (pages-design.md §1):
   the worker measures with the exact same files the page paints with. */
@font-face { font-family: 'Crimson Text'; src: url('/fonts/crimson-400.woff2') format('woff2');
  font-weight: 400; font-style: normal; font-display: block; }
@font-face { font-family: 'Crimson Text'; src: url('/fonts/crimson-400i.woff2') format('woff2');
  font-weight: 400; font-style: italic; font-display: block; }
@font-face { font-family: 'Crimson Text'; src: url('/fonts/crimson-700.woff2') format('woff2');
  font-weight: 700; font-style: normal; font-display: block; }
</style>
<style>
:root { --paper:#faf8f2; --ink:#1c1a17; --muted:#8a857c; --line:#e4dfd4; --accent:#1a5276; }
@media (prefers-color-scheme: dark) {
  :root { --paper:#191817; --ink:#e6e2da; --muted:#8f8b81; --line:#2e2c29; --accent:#7fb3f5; }
}
* { margin:0; box-sizing:border-box; }
body { background:var(--paper); color:var(--ink);
  font-family:"Crimson Text", Georgia, serif; font-size:18px; line-height:1.5; }
.shell { max-width:44em; margin:0 auto; padding:2.2em 1.2em 4em; }
header.site { display:flex; justify-content:space-between; align-items:baseline;
  border-bottom:1px solid var(--line); padding-bottom:.8em; margin-bottom:2.2em; }
header.site .brand { font-weight:700; font-size:1.15em; letter-spacing:.02em;
  color:var(--ink); text-decoration:none; }
header.site nav a { color:var(--muted); text-decoration:none; margin-left:1.2em; font-size:.92em; }
header.site nav a:hover { color:var(--accent); }
.lang-switch { display:flex; justify-content:flex-end; gap:.45em; margin:0 0 1em;
  position:relative; z-index:5; }
.lang-switch button { font:inherit; font-size:.8em; padding:.15em .65em; cursor:pointer;
  background:none; color:var(--muted); border:1px solid var(--line); border-radius:3px; }
.lang-switch button:hover { color:var(--accent); border-color:var(--accent); }
.lang-switch button.on { color:var(--paper); background:var(--accent); border-color:var(--accent); }
.lang-switch button:disabled { opacity:.45; cursor:default; }
footer.site { border-top:1px solid var(--line); margin-top:3.5em; padding-top:1em;
  color:var(--muted); font-size:.85em; }
a { color:var(--accent); }
.post .tsr-flow img { max-width:100%; height:auto; }
.post .tsr-flow pre { overflow-x:auto; background:rgba(125,125,125,.06);
  padding:.7em .9em; border-radius:4px; font-size:.85em; line-height:1.55; }
.post .tsr-flow figure { margin:1.4em 0; text-align:center; }
.post .tsr-flow figcaption { color:var(--muted); font-size:.92em; margin-top:.5em; }
.post .tsr-flow h1, .post .tsr-flow h2, .post .tsr-flow h3 { line-height:1.3; margin:1.4em 0 .6em; }
.post .tsr-flow p { margin:.8em 0; }
.post .tsr-flow blockquote { border-left:3px solid var(--line); padding-left:1em; color:var(--muted); }
.book-crumbs { color:var(--muted); font-size:.88em; margin-bottom:1.4em; }
.book-crumbs a { color:inherit; text-decoration:none; }
.book-crumbs a:hover { color:var(--accent); }
.book-draft { border:1px dashed var(--muted); color:var(--muted); border-radius:4px;
  padding:.45em .8em; margin-bottom:1.4em; font-size:.92em; }
.book-pager { display:flex; justify-content:space-between; gap:1em; margin-top:3em;
  padding-top:1em; border-top:1px solid var(--line); font-size:.95em; }
.book-pager a { text-decoration:none; }
.book-pager .next { margin-left:auto; text-align:right; }
.book-list { list-style:none; }
.book-list li { padding:.7em 0; border-bottom:1px dashed var(--line); }
.book-list a { text-decoration:none; font-weight:700; }
.book-list .sub, .book-list .count { color:var(--muted); font-size:.9em; }
</style>
{%- if tsr %}
<style>
/* the engine's stylesheet: its render contract and theme, each document's
   rules under its own article (eleventy.config.js headOf) */
{{ tsr.head | safe }}</style>
{%- endif %}
</head>
<body>
<div class="shell">
<header class="site">
  <a class="brand" href="/">zball</a>
  <nav><a href="/">文章</a>{% if books.list.length %}<a href="/books/">书</a>{% endif %}<a href="/docs/">文档</a><a href="/feed.xml">订阅</a></nav>
</header>
<main>
{{ content | safe }}
</main>
<footer class="site">© zball · 由自研 TeX 级排版引擎驱动 ·
  <a href="https://github.com/zball-bz/Typesetter">Typesetter</a></footer>
</div>
</body>
</html>
