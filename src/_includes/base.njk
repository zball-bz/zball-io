<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}zball</title>
{%- if robots %}
<meta name="robots" content="{{ robots }}">
{%- endif %}
<link rel="alternate" type="application/atom+xml" href="/feed.xml" title="zball">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;700&display=swap">
<script>try { if (localStorage.getItem('zb-toc') === 'closed') document.documentElement.dataset.toc = 'closed'; } catch {}</script>
<style>
/* Latin face is SELF-HOSTED and declared to the engine (pages-design.md §1):
   the worker measures with the exact same files the page paints with. */
@font-face { font-family: 'Crimson Text'; src: url('/fonts/crimson-400.woff2') format('woff2');
  font-weight: 400; font-style: normal; font-display: block; }
@font-face { font-family: 'Crimson Text'; src: url('/fonts/crimson-400i.woff2') format('woff2');
  font-weight: 400; font-style: italic; font-display: block; }
@font-face { font-family: 'Crimson Text'; src: url('/fonts/crimson-700.woff2') format('woff2');
  font-weight: 700; font-style: normal; font-display: block; }
</style>
<style>
:root { --paper:#faf8f2; --ink:#1c1a17; --muted:#8a857c; --line:#e4dfd4; --accent:#1a5276; }
@media (prefers-color-scheme: dark) {
  :root { --paper:#191817; --ink:#e6e2da; --muted:#8f8b81; --line:#2e2c29; --accent:#7fb3f5; }
}
* { margin:0; box-sizing:border-box; }
/* the scrollbar's room kept: a page shown in place, long or short, has the
   width it was typeset at (lib/client/zb.mjs) */
html { scrollbar-gutter:stable; }
body { background:var(--paper); color:var(--ink);
  font-family:"Crimson Text", Georgia, serif; font-size:18px; line-height:1.5; }
.shell { max-width:44em; margin:0 auto; padding:2.2em 1.2em 4em; }
main:focus { outline:none; }
/* a page being typeset out of sight, at its width (lib/client/zb.mjs) */
.zb-offstage { position:absolute; top:0; left:0; right:0; height:0; overflow:hidden;
  visibility:hidden; pointer-events:none; }
#zb-progress { position:fixed; top:0; left:0; height:2px; width:0; z-index:100;
  background:var(--accent); opacity:0; pointer-events:none; }
.zb-loading #zb-progress { opacity:1; width:85%; transition:width 8s cubic-bezier(.1,.6,.2,1), opacity .2s; }
header.site { display:flex; justify-content:space-between; align-items:baseline;
  border-bottom:1px solid var(--line); padding-bottom:.8em; margin-bottom:2.2em; }
header.site .brand { font-weight:700; font-size:1.15em; letter-spacing:.02em;
  color:var(--ink); text-decoration:none; }
header.site nav a { color:var(--muted); text-decoration:none; margin-left:1.2em; font-size:.92em; }
header.site nav a:hover { color:var(--accent); }
.lang-switch { display:flex; justify-content:flex-end; gap:.45em; margin:0 0 1em;
  position:relative; z-index:5; }
.lang-switch button { font:inherit; font-size:.8em; padding:.15em .65em; cursor:pointer;
  background:none; color:var(--muted); border:1px solid var(--line); border-radius:3px; }
.lang-switch button:hover { color:var(--accent); border-color:var(--accent); }
.lang-switch button.on { color:var(--paper); background:var(--accent); border-color:var(--accent); }
.lang-switch button:disabled { opacity:.45; cursor:default; }
footer.site { border-top:1px solid var(--line); margin-top:3.5em; padding-top:1em;
  color:var(--muted); font-size:.85em; }
a { color:var(--accent); }
.post .tsr-flow img { max-width:100%; height:auto; }
.post .tsr-flow pre { overflow-x:auto; background:rgba(125,125,125,.06);
  padding:.7em .9em; border-radius:4px; font-size:.85em; line-height:1.55; }
.post .tsr-flow figure { margin:1.4em 0; text-align:center; }
.post .tsr-flow figcaption { color:var(--muted); font-size:.92em; margin-top:.5em; }
.post .tsr-flow h1, .post .tsr-flow h2, .post .tsr-flow h3 { line-height:1.3; margin:1.4em 0 .6em; }
.post .tsr-flow p { margin:.8em 0; }
.post .tsr-flow blockquote { border-left:3px solid var(--line); padding-left:1em; color:var(--muted); }
.book-crumbs { display:flex; align-items:baseline; gap:.7em; color:var(--muted); font-size:.88em;
  margin-bottom:1.4em; }
.book-crumbs a { color:inherit; text-decoration:none; }
.book-crumbs a:hover { color:var(--accent); }
.book-draft { border:1px dashed var(--muted); color:var(--muted); border-radius:4px;
  padding:.45em .8em; margin-bottom:1.4em; font-size:.92em; }
.book-pager { display:flex; justify-content:space-between; gap:1em; margin-top:3em;
  padding-top:1em; border-top:1px solid var(--line); font-size:.95em; }
.book-pager a { text-decoration:none; }
.book-pager .next { margin-left:auto; text-align:right; }
/* a book: its contents beside a column of 40 characters (40em: CJK lines
   of whole characters, no stretched spacing; 80 columns of code) */
.shell-book { max-width:61em; }
.book { display:grid; grid-template-columns:15em minmax(0, 40em); column-gap:3em; justify-content:center; }
.book-main { min-width:0; }
.book-main article.post { width:100%; width:round(down, 100%, 1em); }
.book-toc { position:sticky; top:1.2em; align-self:start; max-height:calc(100vh - 2.4em);
  overflow:auto; overscroll-behavior:contain; font-size:.86em; line-height:1.45; padding:0 .3em 1em 0; }
html[data-toc=closed] .book { grid-template-columns:minmax(0, 40em); }
html[data-toc=closed] .book-toc { display:none; }
.toc-toggle { font:inherit; font-size:.95em; padding:.05em .55em; cursor:pointer; background:none;
  color:var(--muted); border:1px solid var(--line); border-radius:3px; }
.toc-toggle:hover { color:var(--accent); border-color:var(--accent); }
.book-toc a { color:var(--ink); text-decoration:none; }
.book-toc a:hover { color:var(--accent); }
.book-toc a[aria-current], .book-toc a.active { color:var(--accent); }
.book-toc a[aria-current] { font-weight:700; }
.toc-book { display:block; font-weight:700; font-size:1.08em; margin-bottom:.8em; }
.toc-part { color:var(--muted); font-size:.85em; letter-spacing:.08em; margin:1em 0 .3em; }
.book-toc ol { list-style:none; padding:0; }
.toc-ch { margin:.15em 0; }
.toc-ch > a, .toc-ch summary { display:block; padding:.2em 0 .2em 1.1em; position:relative; }
.toc-ch summary { list-style:none; cursor:pointer; }
.toc-ch summary::-webkit-details-marker { display:none; }
.toc-ch summary::before { content:""; position:absolute; left:.25em; top:.72em; border:.28em solid transparent;
  border-left-color:var(--muted); transition:transform .15s; transform-origin:25% 50%; }
.toc-ch details[open] > summary::before { transform:rotate(90deg); }
.toc-n { color:var(--muted); margin-right:.45em; font-variant-numeric:tabular-nums; }
.toc-draft { margin-left:.4em; font-size:.78em; color:var(--muted); border:1px solid var(--line);
  border-radius:3px; padding:0 .3em; }
.toc-secs { margin:.1em 0 .4em 1.1em; border-left:1px solid var(--line); }
.toc-secs a { display:block; padding:.12em 0 .12em .8em; font-size:.95em; }
.toc-secs .toc-l3 a { padding-left:1.8em; font-size:.9em; }
.toc-secs a.active { box-shadow:inset 2px 0 var(--accent); }
.book-toc .tsr-math { zoom:.86; }
.book-backdrop { display:none; }
@media (max-width: 1100px) {
  .book { grid-template-columns:minmax(0, 40em); }
  .book-toc { position:fixed; top:0; bottom:0; left:0; z-index:40; width:min(20em, 86vw); max-height:none;
    padding:1.4em 1em; background:var(--paper); font-size:.95em; transform:translateX(-105%);
    transition:transform .2s ease; box-shadow:0 0 2em rgba(0,0,0,.18); }
  html[data-toc=closed] .book-toc { display:block; }
  html[data-toc-open] .book-toc { transform:none; }
  html[data-toc-open] .book-backdrop { display:block; position:fixed; inset:0; z-index:39; background:rgba(0,0,0,.25); }
}
.book-list { list-style:none; }
.book-list li { padding:.7em 0; border-bottom:1px dashed var(--line); }
.book-list a { text-decoration:none; font-weight:700; }
.book-list .sub, .book-list .count { color:var(--muted); font-size:.9em; }
</style>
{#- the engine's stylesheets: its render contract and theme, each
    document's rules under its own scope (lib/tsr.mjs) #}
{%- if tsr %}
{{ tsr.head | safe }}
{%- endif %}
<script type="application/json" id="zb-site">{{ zb | dump | safe }}</script>
<script type="module" src="{{ zb.js }}"></script>
</head>
<body>
<div id="zb-progress" aria-hidden="true"></div>
<div class="shell{% if shell %} shell-{{ shell }}{% endif %}" id="zb-shell">
<header class="site">
  <a class="brand" href="/">zball</a>
  <nav><a href="/">文章</a>{% if books.list.length %}<a href="/books/">书</a>{% endif %}<a href="/books/typesetter/">文档</a><a href="/feed.xml">订阅</a></nav>
</header>
<main tabindex="-1">
{{ content | safe }}
</main>
<footer class="site">© zball · 由自研 TeX 级排版引擎驱动 ·
  <a href="https://github.com/zball-bz/Typesetter">Typesetter</a></footer>
</div>
</body>
</html>
